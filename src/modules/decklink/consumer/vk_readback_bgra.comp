#version 450

/*
 * BGRA8 subregion extraction compute shader for DeckLink output.
 *
 * Reads the VK mixer's render attachment (RGBA UNORM texture) via texelFetch,
 * swizzles RGBA → BGRA, and packs as uint32.
 *
 * Each invocation handles one pixel.  WorkgroupSize = (16, 16, 1).
 * Dispatch: ((dst_w + 15) / 16,  (dst_h + 15) / 16,  1)
 */

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D src_tex;

layout(set = 0, binding = 1) buffer BGRAOutput {
    uint data[];
} bgra_out;

layout(push_constant) uniform PushConstants {
    int src_x;   // subregion origin X in source texture
    int src_y;   // subregion origin Y in source texture
    int dst_w;   // DeckLink output width
    int dst_h;   // DeckLink output height
} pc;

void main()
{
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);

    if (x >= pc.dst_w || y >= pc.dst_h)
        return;

    int sx = pc.src_x + x;
    int sy = pc.src_y + y;

    vec4 pixel = texelFetch(src_tex, ivec2(sx, sy), 0);

    // The attachment ALREADY holds BGRA, so this is a straight copy: channel 0 -> byte 0.
    //
    // The VK mixer writes BGRA into an R8G8B8A8_UNORM image -- which is why
    // screen_consumer.cpp applies a corrective SWIZZLE_R/SWIZZLE_B when it imports the same
    // texture, and why vk_readback_v210.comp reads .b for red at 8 bits. This shader's
    // comment claimed an RGBA source and swizzled to match, exchanging red and blue a
    // second time.
    //
    // No bit-depth branch, unlike v210: this shader is reached only through the rgba output
    // path, and config.cpp rejects rgba output on anything but an 8-bit channel ("The
    // decklink consumer only supports rgba output on 8-bit channels"). So the source here
    // is always the 8-bit BGRA attachment.
    uint b0 = uint(pixel.r * 255.0 + 0.5);
    uint b1 = uint(pixel.g * 255.0 + 0.5);
    uint b2 = uint(pixel.b * 255.0 + 0.5);
    uint A  = uint(pixel.a * 255.0 + 0.5);

    uint packed = b0 | (b1 << 8u) | (b2 << 16u) | (A << 24u);

    uint idx = uint(y) * uint(pc.dst_w) + uint(x);
    bgra_out.data[idx] = packed;
}
