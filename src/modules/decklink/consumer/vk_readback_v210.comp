#version 450

/*
 * V210 packing compute shader for DeckLink output.
 *
 * Reads the VK mixer's render attachment (RGBA UNORM texture) via texelFetch,
 * converts to YCbCr 4:2:2, and packs into V210 format (10-bit per component,
 * 6 pixels → 4 uint32 words per V210 group).
 *
 * Each invocation handles one V210 group.  WorkgroupSize = (64, 1, 1).
 * Dispatch: ((groups_per_row + 63) / 64,  dst_h,  1)
 *
 * Supports both BT.709 (SDR) and BT.2020 (HDR) color matrices.
 * The texture format (8-bit vs 16-bit) is transparent — texelFetch on UNORM
 * returns normalized [0,1] floats regardless.
 */

layout(local_size_x = 64, local_size_y = 1) in;

layout(set = 0, binding = 0) uniform sampler2D src_tex;

layout(set = 0, binding = 1) buffer V210Output {
    uint data[];
} v210_out;

layout(push_constant) uniform PushConstants {
    int src_x;           // subregion origin X in source texture
    int src_y;           // subregion origin Y in source texture
    int dst_w;           // DeckLink output width
    int dst_h;           // DeckLink output height
    int groups_per_row;  // (dst_w + 5) / 6
    int use_bt2020;      // 0 = BT.709, 1 = BT.2020
    int is_16bit;        // 0 = 8-bit (BGRA swizzled), 1 = 16-bit (RGBA direct)
    // ── Destination placement ───────────────────────────────────────────────
    // Where the region lands on the DeckLink frame, and how big it is. With no
    // subregion the strategy passes dest=(0,0) and region=(dst_w,dst_h), which reduces
    // the arithmetic below to exactly what it was before these existed.
    //
    // ITERATING OVER OUTPUT GROUPS IS WHAT MAKES THIS CHEAP, and it is why `dest_x` needs
    // no 6-pixel alignment. A V210 group is 6 pixels, so a region starting at a `dest_x`
    // that is not a multiple of 6 straddles a group -- which would need read-modify-write
    // if we walked the SOURCE. Walking the destination instead, every group is computed in
    // full from scratch: the pixels inside the region are sampled, the rest are black. A
    // straddling group is simply a group with both kinds in it.
    //
    // Writing every group also fills the area outside the region, so no separate clear
    // pass is needed and the frame can never carry stale pixels.
    int dest_x;
    int dest_y;
    int region_w;
    int region_h;
} pc;

// ─── BT.709 full-range → 10-bit limited-range YCbCr ────────────────────────

void rgb_to_ycbcr_bt709(int R, int G, int B, out int Y, out int Cb, out int Cr)
{
    // Legal/limited-range BT.709, identical fixed-point coefficients to the CPU
    // packer (v210_strategies.cpp): luma x 876/1023, chroma x 896/1023.
    Y  = ((64 << 20)   + 190929 * R + 642151 * G +  64822 * B) >> 20;
    Cb = ((1025 << 19) - 105242 * R - 353959 * G + 459200 * B) >> 20;
    Cr = ((1025 << 19) + 459200 * R - 417097 * G -  42104 * B) >> 20;

    Y  = clamp(Y,  0, 1023);
    Cb = clamp(Cb, 0, 1023);
    Cr = clamp(Cr, 0, 1023);
}

// ─── BT.2020 full-range → 10-bit limited-range YCbCr ───────────────────────

void rgb_to_ycbcr_bt2020(int R, int G, int B, out int Y, out int Cb, out int Cr)
{
    // Legal/limited-range BT.2020 (KR=0.2627, KG=0.6780, KB=0.0593).
    Y  = ((64 << 20)   + 235879 * R + 608775 * G +  53247 * B) >> 20;
    Cb = ((1025 << 19) - 128237 * R - 330964 * G + 459200 * B) >> 20;
    Cr = ((1025 << 19) + 459200 * R - 422267 * G -  36934 * B) >> 20;

    Y  = clamp(Y,  0, 1023);
    Cb = clamp(Cb, 0, 1023);
    Cr = clamp(Cr, 0, 1023);
}

// ─── Main ──────────────────────────────────────────────────────────────────

void main()
{
    int group_x = int(gl_GlobalInvocationID.x);
    int row     = int(gl_GlobalInvocationID.y);

    if (row >= pc.dst_h || group_x >= pc.groups_per_row)
        return;

    int px_base = group_x * 6;

    // Load 6 pixels, convert to 10-bit
    int R[6], G[6], B[6];

    for (int i = 0; i < 6; ++i) {
        // Output pixel -> position within the region -> source pixel.
        int ox = px_base + i;
        int rx = ox  - pc.dest_x;
        int ry = row - pc.dest_y;
        int sx = pc.src_x + rx;
        int sy = pc.src_y + ry;

        vec4 pixel;
        // Inside the frame AND inside the destination rectangle. Anything else stays at
        // the initialised value, which is black -- that is what fills the surround.
        if (ox < pc.dst_w
            && rx >= 0 && rx < pc.region_w
            && ry >= 0 && ry < pc.region_h) {
            pixel = texelFetch(src_tex, ivec2(sx, sy), 0);
        } else {
            pixel = vec4(0.0);
        }

        // For 8-bit: the mixer's fragment shader writes fragColor=col.bgra, so the
        // render attachment stores BGRA in what is formally an RGBA format.
        // texelFetch returns .r = Blue (position 0), .b = Red (position 2).
        // For 16-bit: the shader writes RGBA directly, so .r = Red, .b = Blue.
        if (pc.is_16bit != 0) {
            R[i] = int(pixel.r * 1023.0 + 0.5);
            G[i] = int(pixel.g * 1023.0 + 0.5);
            B[i] = int(pixel.b * 1023.0 + 0.5);
        } else {
            // 8-bit: recover the byte and scale <<2 (as R8<<2), matching the CPU packer.
            R[i] = int(pixel.b * 255.0 + 0.5) << 2;
            G[i] = int(pixel.g * 255.0 + 0.5) << 2;
            B[i] = int(pixel.r * 255.0 + 0.5) << 2;
        }
    }

    // Convert to YCbCr
    int Y[6], Cb_raw[6], Cr_raw[6];

    for (int i = 0; i < 6; ++i) {
        if (pc.use_bt2020 != 0) {
            rgb_to_ycbcr_bt2020(R[i], G[i], B[i], Y[i], Cb_raw[i], Cr_raw[i]);
        } else {
            rgb_to_ycbcr_bt709(R[i], G[i], B[i], Y[i], Cb_raw[i], Cr_raw[i]);
        }
    }

    // 4:2:2 chroma subsampling: co-sited nearest (even pixel), matching the CPU packer.
    int Cb0 = Cb_raw[0];
    int Cr0 = Cr_raw[0];
    int Cb1 = Cb_raw[2];
    int Cr1 = Cr_raw[2];
    int Cb2 = Cb_raw[4];
    int Cr2 = Cr_raw[4];

    // Pack V210 words
    uint w0 = uint(Cb0)  | (uint(Y[0]) << 10) | (uint(Cr0) << 20);
    uint w1 = uint(Y[1]) | (uint(Cb1)  << 10) | (uint(Y[2]) << 20);
    uint w2 = uint(Cr1)  | (uint(Y[3]) << 10) | (uint(Cb2) << 20);
    uint w3 = uint(Y[4]) | (uint(Cr2)  << 10) | (uint(Y[5]) << 20);

    uint base = uint(row) * uint(pc.groups_per_row) * 4u + uint(group_x) * 4u;
    v210_out.data[base + 0u] = w0;
    v210_out.data[base + 1u] = w1;
    v210_out.data[base + 2u] = w2;
    v210_out.data[base + 3u] = w3;
}
